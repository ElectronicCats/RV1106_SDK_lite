#!/bin/sh

# Mount filesystems
/bin/mount -t proc proc /proc
/bin/mount -t sysfs sysfs /sys
/bin/mount -t tmpfs tmpfs /tmp
/bin/mount -t tmpfs tmpfs /var

# Start mdev (dynamic device manager)
/sbin/mdev -s

# Set hostname
/bin/hostname -F /etc/hostname

# SX1262: the radio hardware is now owned by the RISC-V MCU (RadioService over
# rpmsg — docs/migration/design/40-migration-design.md). The old sx1262.ko is obsolete (its SPI DT
# nodes are disabled). Bind the MCU's "rpmsg-radio" channel to rpmsg_chrdev so
# userspace can drive the radio via /dev/rpmsg (radio_test).
# Bind MCU rpmsg service channels to rpmsg_chrdev so userspace can reach them:
# RadioService  (0x4005=16389, virtio0.rpmsg-radio.-1.16389     -> /dev/rpmsg0, radio_test)
# SensorService (0x4006=16390, virtio0.rpmsg-sensor.-1.16390    -> /dev/rpmsg1, sensor_test)
# TelemetryService (0x4007=16391, virtio0.rpmsg-telemetry.-1.16391 -> /dev/rpmsg2, telemetry_test)
bind_rpmsg() {
    ch="$1"
    for i in 1 2 3 4 5; do
        [ -e /sys/bus/rpmsg/devices/${ch} ] && break
        sleep 1
    done
    if [ -e /sys/bus/rpmsg/devices/${ch} ]; then
        echo rpmsg_chrdev > /sys/bus/rpmsg/devices/${ch}/driver_override
        echo ${ch} > /sys/bus/rpmsg/drivers/rpmsg_chrdev/bind
    fi
}
bind_rpmsg virtio0.rpmsg-radio.-1.16389
bind_rpmsg virtio0.rpmsg-sensor.-1.16390
bind_rpmsg virtio0.rpmsg-telemetry.-1.16391
bind_rpmsg virtio0.rpmsg-command.-1.16392
